# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# iKhokha (sandbox/live)
# Dashboard → Integrations → Payment API. Mode: test | live.
IKHOKHA_APP_ID=
IKHOKHA_APP_SECRET=
IKHOKHA_ENTITY_ID=
IKHOKHA_MODE=test
IKHOKHA_BASE_URL=https://api.ikhokha.com
# Webhook signing secret (defaults to IKHOKHA_APP_SECRET if unset)
IKHOKHA_WEBHOOK_SECRET=

# Email
EMAIL_PROVIDER_API_KEY=

# App URLs
APP_BASE_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000
OWNER_APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3002

# Security
ADMIN_TOKEN=

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@laundromaster.app

# Freesound (notification sounds browser; optional — falls back to built-in chime)
FREESOUND_API_KEY=
