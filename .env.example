# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayFast (Settings -> Developer settings in the PayFast dashboard)
# Mode: test | live. Test uses https://sandbox.payfast.co.za automatically.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# Optional passphrase: when set, it is appended to every signature and must
# match the passphrase configured in the PayFast dashboard.
PAYFAST_PASSPHRASE=
PAYFAST_MODE=test
PAYFAST_BASE_URL=https://www.payfast.co.za

# Email
EMAIL_PROVIDER_API_KEY=

# App URLs
APP_BASE_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000
OWNER_APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3002

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Security
ADMIN_TOKEN=

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@laundromaster.app

# Freesound (notification sounds browser; optional — falls back to built-in chime)
FREESOUND_API_KEY=
